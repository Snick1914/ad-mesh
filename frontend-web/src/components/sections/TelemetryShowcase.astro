---
const telemetryFeatures = [
  {
    title: "Monitoreo Eléctrico",
    description: "Medición de voltaje, corriente, factor de potencia y consumo acumulado (kWh) para optimización energética.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    color: "text-yellow-400"
  },
  {
    title: "Variables Ambientales",
    description: "Control preciso de temperatura, humedad relativa, CO2 y calidad del aire en espacios críticos.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`,
    color: "text-blue-400"
  },
  {
    title: "Presión y Fluidos",
    description: "Monitoreo de presión en tuberías, niveles de tanques y detección de fugas mediante sensores ultrasónicos.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
    color: "text-cyan-400"
  },
  {
    title: "Alertas Críticas",
    description: "Notificaciones instantáneas vía Webhook, Email o avisos visuales directos en la red de pantallas ante anomalías.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>`,
    color: "text-red-400"
  }
];
---

<section id="telemetry" class="py-24 bg-[#080a0f] relative overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      
      <!-- Content -->
      <div class="lg:w-1/2">
        <h2 class="text-mesh-accent font-semibold tracking-wide uppercase text-sm mb-3">Telemetría de Grado Industrial</h2>
        <h3 class="text-3xl md:text-5xl font-bold text-white mb-8 leading-tight">Más que imágenes, <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">datos accionables</span></h3>
        <p class="text-lg text-mesh-muted mb-10 leading-relaxed">
          Nuestra infraestructura no solo gestiona pixeles. Integramos hardware de adquisición de datos que se conecta directamente a sus activos críticos, permitiendo una visibilidad total de su operación desde la misma plataforma de señalización.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {telemetryFeatures.map(item => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/[0.08] transition-all group">
              <div class={`w-12 h-12 rounded-xl bg-mesh-dark flex items-center justify-center mb-4 ${item.color} border border-white/5 group-hover:scale-110 transition-transform`} set:html={item.icon} />
              <h4 class="text-white font-bold mb-2">{item.title}</h4>
              <p class="text-mesh-muted text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual Preview / Graphic -->
      <div class="lg:w-1/2 relative">
        <div class="relative bg-mesh-card border border-white/10 rounded-3xl p-8 overflow-hidden shadow-2xl">
          <!-- Sensor Data Mockup -->
          <div class="space-y-6 relative z-10">
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <span class="text-gray-400 text-sm">Sensor ID: <span class="text-mesh-accent">MT-942-A</span></span>
              <span class="bg-green-500/10 text-green-400 text-xs font-bold px-2 py-1 rounded">ACTIVO</span>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-mesh-dark rounded-2xl p-6 border border-white/5">
                <p class="text-gray-500 text-xs mb-1 uppercase tracking-wider">Presión</p>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-bold text-white">42.5</span>
                  <span class="text-mesh-muted text-sm">PSI</span>
                </div>
                <div class="w-full bg-white/5 h-1.5 rounded-full mt-4 overflow-hidden">
                  <div class="bg-blue-500 h-full w-[65%]"></div>
                </div>
              </div>
              <div class="bg-mesh-dark rounded-2xl p-6 border border-white/5">
                <p class="text-gray-500 text-xs mb-1 uppercase tracking-wider">Temperatura</p>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-bold text-white">24.8</span>
                  <span class="text-mesh-muted text-sm">°C</span>
                </div>
                <div class="w-full bg-white/5 h-1.5 rounded-full mt-4 overflow-hidden">
                  <div class="bg-yellow-500 h-full w-[40%]"></div>
                </div>
              </div>
            </div>

            <div class="bg-mesh-dark rounded-2xl p-6 border border-white/5 relative overflow-hidden">
              <div class="absolute top-0 right-0 p-4 opacity-10">
                <svg class="w-20 h-20 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
              </div>
              <p class="text-gray-500 text-xs mb-1 uppercase tracking-wider">Consumo Eléctrico Realtime</p>
              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-4xl font-extrabold text-white">12.4</span>
                <span class="text-mesh-accent text-sm font-bold">kW</span>
              </div>
              <div class="flex gap-1 items-end h-16">
                <div class="bg-mesh-accent/20 w-full h-[40%] rounded-t"></div>
                <div class="bg-mesh-accent/30 w-full h-[60%] rounded-t"></div>
                <div class="bg-mesh-accent/20 w-full h-[30%] rounded-t"></div>
                <div class="bg-mesh-accent/40 w-full h-[80%] rounded-t"></div>
                <div class="bg-mesh-accent/60 w-full h-[50%] rounded-t"></div>
                <div class="bg-mesh-accent w-full h-[90%] rounded-t animate-pulse"></div>
              </div>
            </div>
          </div>

          <!-- Decorative Glow -->
          <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-mesh-accent/20 blur-[80px] rounded-full pointer-events-none"></div>
        </div>

        <!-- Float Tags -->
        <div class="absolute -top-6 -right-6 bg-blue-600 text-white p-4 rounded-2xl shadow-xl border border-white/10 hidden md:block animate-bounce-slow">
          <div class="flex items-center gap-3">
             <div class="w-2 h-2 rounded-full bg-white animate-ping"></div>
             <span class="text-sm font-bold">Modbus TCP / MQTT ready</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s infinite ease-in-out;
  }
</style>
