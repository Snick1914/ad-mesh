---
const metrics = [
  { value: "+500", label: "Players Desplegados" },
  { value: "99.98%", label: "Uptime Operativo" },
  { value: "+15M", label: "Eventos de Sensores Procesados" },
  { value: "0h", label: "Tiempo Fuera de Línea" }
];

const testimonials = [
  {
    quote: "La reproducción offline de ad-mesh resolvió la inestabilidad de señalización en nuestras sucursales. Si se cae el internet, la publicidad sigue reproduciendo y los datos de los sensores se transmiten de inmediato al restablecerse la red.",
    author: "Ing. Alejandro Torres",
    role: "Director de TI en Cadena Comercial del Norte"
  },
  {
    quote: "Poder monitorear la temperatura de nuestras vitrinas refrigeradas y usar las pantallas en piso de venta para notificar alertas inmediatas al personal evitó mermas costosas en más de 20 ocasiones este año.",
    author: "Dra. Sofía Martínez",
    role: "Directora de Operaciones de Red Médica Nacional"
  }
];
---

<section id="social-proof" class="py-24 bg-[#0a0d14] relative border-b border-white/5 overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Metrics Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
      {metrics.map((metric, index) => (
        <div class={`bg-mesh-card border border-white/5 rounded-2xl p-6 text-center hover:border-mesh-accent/30 transition-all duration-300 reveal-up delay-${(index + 1) * 100}`}>
          <p class="text-4xl md:text-5xl font-black text-white mb-2 font-mono bg-clip-text bg-gradient-to-r from-mesh-accent to-blue-500 text-transparent">
            {metric.value}
          </p>
          <p class="text-xs text-mesh-muted uppercase tracking-wider font-semibold">{metric.label}</p>
        </div>
      ))}
    </div>

    <div class="text-center max-w-3xl mx-auto mb-16 reveal-up">
      <h2 class="text-mesh-accent font-semibold tracking-wide uppercase text-sm mb-3">Prueba Social</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">Respaldado por líderes de operaciones</h3>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {testimonials.map((item, index) => (
        <div class={`bg-mesh-card border border-white/10 rounded-2xl p-8 md:p-10 flex flex-col justify-between relative reveal-up delay-${(index + 1) * 150}`}>
          <!-- Quote Icon decoration -->
          <span class="absolute top-6 right-8 text-6xl text-white/5 font-serif select-none pointer-events-none">“</span>
          
          <p class="text-gray-300 text-sm md:text-base leading-relaxed italic mb-8 relative z-10">
            "{item.quote}"
          </p>
          
          <div class="border-t border-white/5 pt-6">
            <p class="text-white font-bold text-base">{item.author}</p>
            <p class="text-mesh-accent text-xs font-semibold">{item.role}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
