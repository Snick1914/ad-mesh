---
---

<section class="relative overflow-hidden bg-mesh-dark pt-32 pb-24 lg:pt-48 lg:pb-36 border-b border-white/5">
  <!-- Background Glows -->
  <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-mesh-accent/10 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-blue-600/10 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Headline & Call to action (5 cols) -->
      <div class="lg:col-span-5 text-left space-y-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-mesh-accent text-sm font-semibold tracking-wide">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mesh-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-mesh-accent"></span>
          </span>
          Sistema Híbrido: Señalización + Telemetría
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] drop-shadow-md">
          Señalización Digital y <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mesh-accent via-cyan-400 to-blue-500">Telemetría Crítica</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-mesh-muted leading-relaxed max-w-lg">
          Sincronización robusta offline de pantallas publicitarias y monitoreo de sensores industriales en tiempo real. La solución integral que nunca se detiene.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a href="#contact" class="px-8 py-4 bg-gradient-to-r from-mesh-accent to-blue-600 hover:from-mesh-accentHover hover:to-blue-500 text-mesh-dark rounded-xl text-lg font-bold transition-all transform hover:scale-[1.03] hover:shadow-[0_0_30px_rgba(0,240,255,0.35)] text-center">
            Agendar Demo Real
          </a>
          <a href="#problem" class="px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white rounded-xl text-lg font-medium transition-all text-center">
            ¿Qué resolvemos?
          </a>
        </div>

        <div class="flex items-center gap-8 pt-6 border-t border-white/10">
          <div>
            <p class="text-3xl font-extrabold text-white">99.98%</p>
            <p class="text-xs text-mesh-muted uppercase tracking-wider font-semibold">Uptime Offline</p>
          </div>
          <div>
            <p class="text-3xl font-extrabold text-white">+500</p>
            <p class="text-xs text-mesh-muted uppercase tracking-wider font-semibold">Nodos Conectados</p>
          </div>
          <div>
            <p class="text-3xl font-extrabold text-white">&lt; 1.5s</p>
            <p class="text-xs text-mesh-muted uppercase tracking-wider font-semibold">Alerta de Anomalía</p>
          </div>
        </div>
      </div>

      <!-- High-fidelity unified render scene (7 cols) -->
      <div class="lg:col-span-7 relative">
        <div class="relative w-full aspect-[4/3] max-w-[650px] mx-auto rounded-3xl border border-white/10 bg-mesh-card/40 p-6 sm:p-10 shadow-2xl backdrop-blur-sm overflow-hidden group">
          <!-- Subtle Grid Background -->
          <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
          
          <!-- Scene Title -->
          <div class="absolute top-4 left-6 flex items-center gap-2 text-[10px] sm:text-xs font-semibold text-white/40 tracking-widest uppercase">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            Vista Unificada del Ecosistema ad-mesh
          </div>

          <!-- The Render Graphic -->
          <div class="relative w-full h-full flex flex-col justify-between mt-4">
            
            <!-- Top Row: Screen & Laptop (Dashboard) -->
            <div class="grid grid-cols-12 gap-4 items-center">
              
              <!-- 1. Digital Signage Screen (Col 7) -->
              <div class="col-span-7 relative">
                <!-- Outer glowing backdrop layer -->
                <div class="absolute -inset-1 bg-mesh-accent/30 rounded-xl blur-xl opacity-60 animate-pulse pointer-events-none"></div>
                
                <div class="rounded-xl border-4 border-slate-800 bg-slate-950 aspect-video shadow-[0_15px_30px_rgba(0,0,0,0.6)] overflow-hidden relative group/screen animate-screen-glow">
                  <!-- Active Content (Simulated Ad) with animation -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-slate-950 via-blue-950 to-indigo-950 animate-gradient-shift flex flex-col justify-between p-3.5 overflow-hidden">
                    <!-- Glowing screen background animation layer -->
                    <div class="absolute inset-0 opacity-30 bg-[radial-gradient(circle_at_top_right,#00f0ff,transparent_50%),radial-gradient(circle_at_bottom_left,#3b82f6,transparent_50%)] animate-pulse pointer-events-none"></div>
                    <!-- Simulated scanlines for screen effect -->
                    <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[size:100%_4px] pointer-events-none opacity-40"></div>
                    
                    <div class="flex justify-between items-start relative z-10">
                      <span class="bg-mesh-accent/20 text-mesh-accent text-[8px] font-bold px-1.5 py-0.5 rounded border border-mesh-accent/30 tracking-wider">REPRODUCIENDO</span>
                      <span class="text-[9px] text-white/50 font-mono">ID: DISPLAY-01</span>
                    </div>
                    <div class="space-y-1.5 relative z-10">
                      <div class="h-2 w-12 bg-mesh-accent/70 rounded"></div>
                      <div class="text-xs sm:text-sm font-black text-white uppercase tracking-tight leading-tight">Campañas Activas & Mensajería en Vivo</div>
                      <div class="h-1 w-full bg-white/20 rounded overflow-hidden">
                        <div class="bg-mesh-accent h-full w-2/3 animate-pulse"></div>
                      </div>
                    </div>
                  </div>
                  <!-- Active connection overlay glow -->
                  <div class="absolute inset-0 border border-mesh-accent/30 rounded-lg pointer-events-none"></div>
                </div>
                <!-- Label tag for screen -->
                <div class="absolute -bottom-3 left-4 bg-slate-900/90 border border-white/10 rounded-full px-3 py-0.5 text-[9px] font-bold text-gray-300 shadow flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-mesh-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a2 2 0 002-2V6a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Pantalla Digital (4K HDMI)</span>
                </div>
              </div>

              <!-- 2. Dashboard Laptop (Col 5) -->
              <div class="col-span-5 relative translate-y-4">
                <div class="bg-slate-900 rounded-lg border border-white/10 p-2 shadow-2xl overflow-hidden aspect-[4/3] flex flex-col">
                  <!-- Header dot layout -->
                  <div class="flex items-center gap-1 mb-1.5 opacity-40">
                    <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-yellow-500"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                  </div>
                  <!-- Dashboard Contents -->
                  <div class="bg-slate-950 flex-grow rounded border border-white/5 p-1.5 flex flex-col justify-between text-[7px] font-mono">
                    <div class="flex justify-between border-b border-white/5 pb-1">
                      <span class="text-white/40">Status</span>
                      <span class="text-green-400 font-bold">● ONLINE</span>
                    </div>
                    <div class="space-y-1 my-1">
                      <div class="flex justify-between">
                        <span class="text-gray-400">Temp:</span>
                        <span class="text-mesh-accent font-bold">24.8°C</span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-gray-400">Consumo:</span>
                        <span class="text-yellow-400 font-bold">12.4 kW</span>
                      </div>
                    </div>
                    <div class="h-5 bg-mesh-accent/5 border border-mesh-accent/20 rounded flex items-end p-0.5 overflow-hidden">
                      <!-- Tiny spark chart -->
                      <div class="flex items-end gap-[1px] w-full h-full">
                        <div class="bg-mesh-accent/30 w-1/6 h-[30%]"></div>
                        <div class="bg-mesh-accent/30 w-1/6 h-[50%]"></div>
                        <div class="bg-mesh-accent/50 w-1/6 h-[40%]"></div>
                        <div class="bg-mesh-accent/60 w-1/6 h-[70%]"></div>
                        <div class="bg-mesh-accent/80 w-1/6 h-[60%]"></div>
                        <div class="bg-mesh-accent w-1/6 h-[90%]"></div>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Keyboard base structure -->
                <div class="h-2 w-[110%] -ml-[5%] bg-slate-800 rounded-b-md shadow border-t border-slate-700"></div>
                <div class="absolute -bottom-6 right-2 bg-slate-900/90 border border-white/10 rounded-full px-3 py-0.5 text-[9px] font-bold text-gray-300 shadow flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-mesh-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                  </svg>
                  <span>Dashboard de Control</span>
                </div>
              </div>
            </div>

            <!-- Connection lines / glow wires -->
            <div class="absolute top-[40%] left-[60%] w-[12%] h-[20%] border-t-2 border-r-2 border-dashed border-mesh-accent/40 rounded-tr-xl pointer-events-none hidden sm:block"></div>
            
            <!-- Bottom Row: Player Hardware & Industrial Sensor -->
            <div class="grid grid-cols-12 gap-4 mt-8 items-end">
              
              <!-- 3. Hardware Player (Col 6) -->
              <div class="col-span-6 relative">
                <div class="bg-slate-900 border border-white/20 rounded-xl p-3 shadow-[0_15px_30px_rgba(0,0,0,0.5)] flex items-center gap-3 group-hover:border-mesh-accent/50 transition-all">
                  <!-- Fanless Player SVG representation -->
                  <div class="w-12 h-12 bg-slate-950 rounded border border-white/10 p-1 flex flex-col justify-between shrink-0">
                    <!-- Metal fins design -->
                    <div class="flex gap-[2px] justify-center h-4">
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                      <div class="w-[3px] bg-slate-700 rounded-t"></div>
                    </div>
                    <div class="flex justify-between items-center px-0.5">
                      <div class="flex gap-1">
                        <div class="w-1.5 h-1.5 rounded-full bg-mesh-accent animate-pulse"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                      </div>
                      <div class="w-2.5 h-1 bg-yellow-500 rounded-sm"></div>
                    </div>
                  </div>
                  <div class="text-[9px] sm:text-xs">
                    <p class="font-bold text-white leading-tight">Player Industrial</p>
                    <p class="text-mesh-accent font-semibold text-[8px] sm:text-[10px] tracking-wide">FANLESS / OFFLINE</p>
                    <p class="text-[8px] text-gray-500 font-mono">HDMI + USB/HDD</p>
                  </div>
                </div>
                <!-- Glowing wire linking Player to Screen -->
                <div class="absolute -top-[50%] left-[20%] w-2 h-10 border-l-2 border-b-2 border-mesh-accent/60 rounded-bl-lg pointer-events-none hidden sm:block"></div>
                <div class="absolute -bottom-3 left-4 bg-slate-900/90 border border-white/10 rounded-full px-3 py-0.5 text-[9px] font-bold text-gray-300 shadow flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-mesh-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                  </svg>
                  <span>Hardware Player</span>
                </div>
              </div>

              <!-- 4. Modbus/Industrial Sensor (Col 6) -->
              <div class="col-span-6 relative">
                <div class="bg-slate-900/90 border border-white/20 rounded-xl p-3 shadow-lg flex items-center gap-2 group-hover:border-blue-400 transition-all">
                  <!-- Sensor visual representation -->
                  <div class="w-10 h-10 bg-gradient-to-br from-slate-800 to-slate-950 rounded-full border-2 border-blue-500 flex items-center justify-center shrink-0 shadow-[0_0_10px_rgba(59,130,246,0.3)]">
                    <svg class="w-5 h-5 text-blue-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  </div>
                  <div>
                    <p class="font-bold text-white text-[9px] sm:text-xs leading-none">Sensor Monitoreo</p>
                    <div class="flex items-center gap-1.5 mt-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                      <span class="text-[9px] sm:text-[10px] text-gray-300 font-mono">Modbus / I2C</span>
                    </div>
                    <span class="text-[9px] bg-blue-500/10 text-blue-400 font-bold px-1 py-0.2 rounded border border-blue-500/20">TEMP & PRESS</span>
                  </div>
                </div>
                <!-- Glowing wire linking Sensor to Player -->
                <div class="absolute -top-[10px] -left-[20px] w-8 h-10 border-b-2 border-l-2 border-dashed border-blue-400/50 rounded-bl-xl pointer-events-none hidden sm:block"></div>
                <div class="absolute -bottom-3 right-4 bg-slate-900/90 border border-white/10 rounded-full px-3 py-0.5 text-[9px] font-bold text-gray-300 shadow flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v-2m6 2v-2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                  <span>Sensor de Activos</span>
                </div>
              </div>

            </div>
          </div>
          
          <!-- Decorative overall glows inside scene -->
          <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-mesh-accent/15 blur-[60px] rounded-full pointer-events-none"></div>
          <div class="absolute -top-12 -left-12 w-48 h-48 bg-blue-500/15 blur-[60px] rounded-full pointer-events-none"></div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient-shift {
    background-size: 200% 200%;
    animation: gradient-shift 12s ease infinite;
  }
  @keyframes screen-glow {
    0%, 100% {
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.15), inset 0 0 8px rgba(0, 240, 255, 0.05);
      border-color: rgba(30, 41, 59, 0.8);
    }
    50% {
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.5), inset 0 0 15px rgba(0, 240, 255, 0.25);
      border-color: rgba(0, 240, 255, 0.5);
    }
  }
  .animate-screen-glow {
    animation: screen-glow 4s ease-in-out infinite;
  }
</style>
