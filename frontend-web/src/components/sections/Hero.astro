---
---

<section class="relative overflow-hidden bg-mesh-dark pt-32 pb-20 lg:pt-48 lg:pb-32">
  <!-- Background Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-[500px] opacity-20 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-r from-mesh-accent to-blue-600 blur-[100px] rounded-full mix-blend-screen"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-mesh-accent text-sm font-medium mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mesh-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-mesh-accent"></span>
      </span>
      Sistema de grado industrial 100% operativo
    </div>
    
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-8 drop-shadow-lg leading-tight">
      Señalización Digital y <br class="hidden md:block"/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-mesh-accent to-blue-500">Telemetría Industrial</span>
    </h1>
    
    <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-300 mb-10 leading-relaxed">
      Sincronización inteligente de <strong class="text-white font-semibold">anuncios y sensores críticos</strong> con reproducción local offline. Tus pantallas y datos nunca se detienen, sin importar la conexión.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <a href="#contact" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-mesh-accent to-blue-600 hover:from-mesh-accentHover hover:to-blue-500 text-mesh-dark rounded-full text-lg font-bold transition-all transform hover:scale-105 hover:shadow-[0_0_20px_rgba(0,240,255,0.4)] focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:ring-offset-2 focus:ring-offset-mesh-dark">
        Desplegar mi red
      </a>
      <a href="#features" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-white text-lg font-medium transition-all transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white/20">
        Explorar Tecnología
      </a>
    </div>

    <!-- Dashboard Preview Mockup -->
    <div class="mt-20 relative mx-auto max-w-5xl">
      <div class="rounded-xl border border-white/10 bg-mesh-card p-2 shadow-2xl relative overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-t from-mesh-dark via-transparent to-transparent z-10"></div>
        <div class="flex items-center gap-2 mb-4 px-2 pt-2 opacity-50">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <div class="grid grid-cols-3 gap-4 pb-12 px-2 relative z-0">
          <div class="col-span-2 bg-mesh-dark rounded border border-white/5 h-64 p-4 flex flex-col justify-between">
            <div class="w-1/3 h-4 bg-white/10 rounded"></div>
            <div class="w-full h-32 bg-gradient-to-r from-white/5 to-white/10 rounded mt-4"></div>
          </div>
          <div class="bg-mesh-dark rounded border border-white/5 h-64 p-4 flex flex-col gap-3">
             <div class="w-1/2 h-4 bg-white/10 rounded mb-2"></div>
             <div class="w-full h-12 bg-white/5 rounded flex items-center px-3"><div class="w-2 h-2 rounded-full bg-mesh-accent mr-2"></div><div class="w-20 h-2 bg-white/20 rounded"></div></div>
             <div class="w-full h-12 bg-white/5 rounded flex items-center px-3"><div class="w-2 h-2 rounded-full bg-mesh-accent mr-2"></div><div class="w-24 h-2 bg-white/20 rounded"></div></div>
             <div class="w-full h-12 bg-white/5 rounded flex items-center px-3"><div class="w-2 h-2 rounded-full bg-red-500 mr-2"></div><div class="w-16 h-2 bg-white/20 rounded"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
