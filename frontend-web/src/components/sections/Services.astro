---
const services = [
  {
    id: "signage-sol",
    title: "Publicidad y Avisos Dinámicos",
    description: "Gestión centralizada de contenidos multimedia para redes de pantallas. Ideal para transmisión de anuncios, avisos institucionales y señalización dinámica con impacto visual premium.",
    features: ["Programación por horarios y campañas", "Contenido offline garantizado", "Transiciones fluidas 4K nativo", "Monitoreo remoto de reproducción"],
    icon: `<svg class="w-8 h-8 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>`,
    gradient: "from-blue-600/10 to-mesh-accent/10"
  },
  {
    id: "telemetry-sol",
    title: "Monitoreo e Integración de Sensores",
    description: "Integración directa de sensores industriales para monitoreo crítico en tiempo real. Visualice métricas de presión, temperatura, humedad y consumo eléctrico directamente en la misma red.",
    features: ["Dashboard unificado en la nube", "Alertas inmediatas en pantalla", "Historial completo de telemetría", "Compatibilidad Modbus, I2C y MQTT"],
    icon: `<svg class="w-8 h-8 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    gradient: "from-purple-600/10 to-mesh-accent/10"
  }
];
---

<section id="services" class="py-24 bg-[#0a0d14] relative overflow-hidden border-b border-white/5">
  <!-- Decorative background elements -->
  <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-mesh-accent/5 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-blue-600/5 blur-[120px] rounded-full translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-up">
      <h2 class="text-mesh-accent font-semibold tracking-wide uppercase text-sm mb-3">Nuestras Soluciones</h2>
      <h3 class="text-3xl md:text-5xl font-bold text-white mb-6">Dos aplicaciones dedicadas e independientes</h3>
      <p class="text-lg text-mesh-muted leading-relaxed">
        Ofrecemos soluciones separadas y especializadas para cada necesidad. Gestione su comunicación comercial con nuestra aplicación de anuncios y supervise sus variables críticas con nuestra aplicación de telemetría.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {services.map((service, index) => (
        <div class={`group relative bg-mesh-card border border-white/10 rounded-3xl p-8 md:p-12 transition-all duration-500 hover:border-mesh-accent/30 overflow-hidden shadow-xl reveal-up delay-${(index + 1) * 150}`}>
          <!-- Hover Gradient Background -->
          <div class={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
          
          <div class="relative z-10">
            <div class="w-16 h-16 bg-mesh-dark rounded-2xl border border-white/10 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(0,240,255,0.3)] transition-all duration-500" set:html={service.icon} />
            
            <h4 class="text-2xl md:text-3xl font-bold text-white mb-4">{service.title}</h4>
            <p class="text-mesh-muted text-lg mb-8 leading-relaxed">
              {service.description}
            </p>

            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {service.features.map(item => (
                <li class="flex items-center text-gray-300">
                  <svg class="w-5 h-5 text-mesh-accent mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-sm font-medium">{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-10">
              <a href="#use-cases" class="inline-flex items-center text-mesh-accent font-bold hover:text-white transition-colors group/link">
                Ver casos de uso reales
                <svg class="w-5 h-5 ml-2 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
