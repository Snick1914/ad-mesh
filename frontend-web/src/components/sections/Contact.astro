---
---

<section id="contact" class="py-24 bg-mesh-dark relative border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto bg-mesh-card border border-white/10 rounded-3xl overflow-hidden flex flex-col md:flex-row shadow-2xl">
      
      <!-- Contact Info -->
      <div class="bg-gradient-to-br from-blue-900/50 to-mesh-dark p-10 md:w-2/5 flex flex-col justify-between border-b md:border-b-0 md:border-r border-white/10">
        <div>
          <h3 class="text-3xl font-bold text-white mb-4">Transforma tu red hoy</h3>
          <p class="text-mesh-muted mb-8">Déjanos tus datos y un ingeniero especializado se pondrá en contacto para diseñar la arquitectura óptima para tu despliegue.</p>
          
          <div class="space-y-6">
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mr-4">
                <svg class="w-5 h-5 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <span class="text-gray-300">ventas@ad-mesh.com</span>
            </div>
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mr-4">
                <svg class="w-5 h-5 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <span class="text-gray-300">+1 (555) 123-4567</span>
            </div>
          </div>
        </div>
        
        <div class="mt-12 md:mt-0">
          <p class="text-sm text-mesh-muted">Soporte técnico global 24/7 para clientes Enterprise.</p>
        </div>
      </div>

      <!-- Form -->
      <div class="p-10 md:w-3/5 bg-mesh-card">
        <form id="lead-form" class="space-y-6" action="#" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="fullName" class="block text-sm font-medium text-gray-300 mb-2">Nombre completo</label>
              <input type="text" id="fullName" name="fullName" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all"
                placeholder="Ej. Carlos Mendoza">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Correo corporativo</label>
              <input type="email" id="email" name="email" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all"
                placeholder="carlos@empresa.com">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block text-sm font-medium text-gray-300 mb-2">Nombre de la Empresa</label>
              <input type="text" id="company" name="company" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all"
                placeholder="Mi Empresa S.A.">
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-300 mb-2">Teléfono de contacto</label>
              <input type="tel" id="phone" name="phone" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all"
                placeholder="+52 55 1234 5678">
            </div>
          </div>

          <div>
            <label for="screens" class="block text-sm font-medium text-gray-300 mb-2">Cantidad de pantallas a desplegar</label>
            <div class="relative">
              <select id="screens" name="screens" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all appearance-none">
                <option value="" disabled selected class="text-gray-500 bg-mesh-dark">Selecciona un rango...</option>
                <option value="1-5" class="bg-mesh-dark">1 - 5 pantallas (Piloto)</option>
                <option value="6-20" class="bg-mesh-dark">6 - 20 pantallas (Retail local)</option>
                <option value="21-100" class="bg-mesh-dark">21 - 100 pantallas (Expansión regional)</option>
                <option value="100+" class="bg-mesh-dark">Más de 100 pantallas (Enterprise)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <button type="submit" class="w-full bg-mesh-accent hover:bg-mesh-accentHover text-mesh-dark font-bold py-4 rounded-xl transition-all transform hover:scale-[1.02] shadow-[0_0_15px_rgba(0,240,255,0.2)] focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:ring-offset-2 focus:ring-offset-mesh-card">
            Solicitar Contacto Comercial
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      if(btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = 'Enviando...';
        btn.setAttribute('disabled', 'true');
        
        // Simular envío
        setTimeout(() => {
          btn.innerHTML = '¡Solicitud Recibida!';
          btn.classList.add('bg-green-500');
          btn.classList.remove('bg-mesh-accent', 'hover:bg-mesh-accentHover');
          form.reset();
          
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('bg-green-500');
            btn.classList.add('bg-mesh-accent', 'hover:bg-mesh-accentHover');
            btn.removeAttribute('disabled');
          }, 3000);
        }, 1500);
      }
    });
  }
</script>
