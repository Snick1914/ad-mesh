---
---

<section id="how-it-works" class="py-28 bg-[#070a0f] relative border-b border-white/5 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-10 w-[500px] h-[500px] bg-mesh-accent/5 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[500px] bg-indigo-500/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-24">
      <h2 class="text-mesh-accent font-semibold tracking-wide uppercase text-sm mb-3 font-mono">Infraestructura de Datos</h2>
      <h3 class="text-3xl md:text-6xl font-black text-white mb-6 leading-tight">
        Dos flujos físicos, <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-mesh-accent to-blue-500">un solo cerebro digital</span>
      </h3>
      <p class="text-lg text-mesh-muted leading-relaxed">
        El hardware publicitario y el hardware telemático operan en redes de campo independientes, unificando su gestión únicamente en nuestra plataforma web.
      </p>
    </div>

    <!-- Main Architecture Layout (Futuristic Grid Map) -->
    <div class="max-w-5xl mx-auto relative">
      
      <!-- Visual grid backing decoration -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff02_1px,transparent_1px),linear-gradient(to_bottom,#ffffff02_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none rounded-3xl border border-white/5"></div>

      <div class="relative z-10 p-8 sm:p-12 space-y-12">
        
        <!-- 1. THE UNIFIED CONTROL HUB (TOP CENTER NODE) -->
        <div class="relative flex justify-center reveal-scale">
          <div class="w-full max-w-xl bg-gradient-to-br from-slate-900/80 to-slate-950/40 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-[0_15px_40px_rgba(0,0,0,0.5)] relative group">
            
            <!-- Pulse Glow Tag -->
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-mesh-accent/10 border border-mesh-accent/30 text-mesh-accent font-black font-mono text-[9px] px-3 py-1 rounded-full uppercase tracking-widest">
              UNIFIED WEB CONSOLE
            </div>

            <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
              <span class="text-xs font-mono text-gray-400">app.ad-mesh.com</span>
              <div class="flex items-center gap-1.5">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                </span>
                <span class="text-[9px] font-bold text-green-400 uppercase tracking-wider font-mono">CONECTADO</span>
              </div>
            </div>

            <!-- Two main app modules side-by-side -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:divide-x divide-white/10">
              <div class="flex flex-col items-center text-center p-2">
                <div class="w-10 h-10 rounded-xl bg-mesh-accent/10 flex items-center justify-center text-mesh-accent mb-3">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a2 2 0 002-2V6a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <h4 class="text-white font-bold text-xs uppercase tracking-wider">Módulo de Anuncios</h4>
                <p class="text-[10px] text-mesh-muted leading-relaxed mt-1.5">Administre playlists, campañas, contenidos en caché local y layouts en sus displays.</p>
              </div>

              <div class="flex flex-col items-center text-center p-2 md:pl-8">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 mb-3">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                </div>
                <h4 class="text-white font-bold text-xs uppercase tracking-wider">Módulo de Telemetría</h4>
                <p class="text-[10px] text-mesh-muted leading-relaxed mt-1.5">Supervise temperatura (cadena de frío), estado de compresores, energía (kWh) y alertas de activos.</p>
              </div>
            </div>
            
            <div class="mt-4 pt-3 border-t border-white/5 flex justify-center gap-4 text-[9px] text-mesh-muted font-mono">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                Alertas (WhatsApp/SMS)
              </span>
              <span class="text-white/20">•</span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Webhooks / Rest API
              </span>
            </div>
          </div>
        </div>

        <!-- 2. THE PATHWAYS (GRID OF TWO FLOW PIPELINES) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 pt-12 relative">
          
          <!-- Decorative central separation line (desktop) -->
          <div class="absolute inset-y-0 left-1/2 w-px bg-gradient-to-b from-white/5 via-white/10 to-transparent hidden lg:block -translate-x-1/2 z-0"></div>

          <!-- LEFT SIDE: SIGNAGE FLOW PIPELINE (FLUX DOWN) -->
          <div class="space-y-8 relative reveal-up delay-100 pl-4">
            <div class="flex items-center justify-between border-b border-mesh-accent/20 pb-3 mb-6">
              <h4 class="text-white font-black text-sm uppercase tracking-wider flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-mesh-accent animate-pulse shadow-[0_0_8px_#00f0ff]"></span>
                Ruta de Señalización Digital
              </h4>
              <span class="text-[9px] font-mono text-mesh-accent">BAJADA DE CONTENIDO</span>
            </div>

            <div class="border-l border-white/10 pl-6 space-y-12">
              <!-- Edge Player Node -->
              <div class="relative group">
                <div class="text-[9px] font-bold text-mesh-accent tracking-wider font-mono uppercase mb-2">
                  EDGE LAYER
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl bg-slate-950 border border-white/10 flex items-center justify-center text-mesh-accent shrink-0 group-hover:scale-105 transition-all">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="text-white font-bold text-sm">Player ad-mesh AM-200</h5>
                    <p class="text-xs text-mesh-muted mt-1 leading-relaxed">
                      Hardware exclusivo en sitio. Recibe por red encriptada las listas multimedia, descargando y cacheando los archivos en su almacenamiento para reproducción local offline.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Terminal Screen Node -->
              <div class="relative group">
                <div class="text-[9px] font-bold text-gray-500 tracking-wider font-mono uppercase mb-2">
                  DISPLAY LAYER
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl bg-slate-950 border border-white/10 flex items-center justify-center text-mesh-accent shrink-0 group-hover:scale-105 transition-all">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a2 2 0 002-2V6a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="text-white font-bold text-sm">Pantalla de Visualización</h5>
                    <p class="text-xs text-mesh-muted mt-1 leading-relaxed">
                      Conectada al player vía HDMI 4K. Despliega la señal visual de anuncios comerciales y videos con transiciones fluidas de hardware sin interrupciones.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT SIDE: TELEMETRY FLOW PIPELINE (FLUX UP) -->
          <div class="space-y-8 relative reveal-up delay-200 pl-4">
            <div class="flex items-center justify-between border-b border-blue-500/20 pb-3 mb-6">
              <h4 class="text-white font-black text-sm uppercase tracking-wider flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse shadow-[0_0_8px_#3b82f6]"></span>
                Ruta de Telemetría (Sensify)
              </h4>
              <span class="text-[9px] font-mono text-blue-400">SUBIDA DE SENSORES</span>
            </div>

            <div class="border-l border-white/10 pl-6 space-y-12">
              <!-- Field Sensor Node -->
              <div class="relative group">
                <div class="text-[9px] font-bold text-gray-500 tracking-wider font-mono uppercase mb-2">
                  FIELD LAYER
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl bg-slate-950 border border-white/10 flex items-center justify-center text-blue-400 shrink-0 group-hover:scale-105 transition-all">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="text-white font-bold text-sm">Sensores de Campo</h5>
                    <p class="text-xs text-mesh-muted mt-1 leading-relaxed">
                      Sensores Modbus/I2C de temperatura para cadena de frío, humedad o medidores de corriente eléctrica (kWh) instalados directamente en refrigeradores o tableros principales.
                    </p>
                  </div>
                </div>
              </div>

              <!-- IoT Gateway Node -->
              <div class="relative group">
                <div class="text-[9px] font-bold text-blue-400 tracking-wider font-mono uppercase mb-2">
                  GATEWAY LAYER
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl bg-slate-950 border border-white/10 flex items-center justify-center text-blue-400 shrink-0 group-hover:scale-105 transition-all">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="text-white font-bold text-sm">Gateway ad-mesh IoT</h5>
                    <p class="text-xs text-mesh-muted mt-1 leading-relaxed">
                      Hardware de adquisición y enlace. Recopila las mediciones analógicas/digitales en sitio y las envía cifradas por protocolo seguro MQTT a los servidores cloud.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<style>
  @keyframes dash-down {
    to {
      stroke-dashoffset: -40;
    }
  }
  @keyframes dash-up {
    to {
      stroke-dashoffset: 40;
    }
  }
  .animate-dash-down {
    animation: dash-down 2s infinite linear;
  }
  .animate-dash-up {
    animation: dash-up 2s infinite linear;
  }
</style>
