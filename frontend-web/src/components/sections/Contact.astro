---
---

<section id="contact" class="py-24 bg-mesh-dark relative border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Contact Info & Installation/Support Column -->
      <div class="lg:col-span-5 space-y-8 reveal-up delay-100">
        <div>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Transforme su operación</h3>
          <p class="text-mesh-muted text-sm leading-relaxed mb-6">Déjenos sus datos y un ingeniero especializado se pondrá en contacto para diseñar la arquitectura óptima para su despliegue.</p>
          
          <!-- Installation & Support Highlight -->
          <div class="border-l-2 border-mesh-accent pl-5 py-1 mb-8 space-y-2.5 group">
            <h4 class="text-white font-bold text-sm flex items-center gap-2">
              <svg class="w-4 h-4 text-mesh-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Soporte e Instalación Física</span>
            </h4>
            <p class="text-sm text-mesh-muted leading-relaxed">
              No se preocupe por el despliegue. Nuestro equipo técnico se encarga de la instalación en sitio, el cableado de sensores en tableros/neveras y la configuración inicial de red.
            </p>
          </div>

          <div class="space-y-4">
            <div class="flex items-center text-sm">
              <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <span class="text-gray-300">ventas@ad-mesh.com</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <span class="text-gray-300">+52 (55) 8526-1024</span>
            </div>
          </div>
        </div>
        
        <div class="pt-4">
          <p class="text-[11px] text-mesh-muted leading-tight">Garantía de instalación e integraciones a la medida en toda la república.</p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7 bg-white/[0.02] border border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl reveal-up delay-200">
        <form id="lead-form" class="space-y-6" action="#" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="fullName" class="block text-sm font-medium text-gray-300 mb-2">Nombre completo</label>
              <input type="text" id="fullName" name="fullName" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all text-sm"
                placeholder="Ej. Carlos Mendoza">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Correo corporativo</label>
              <input type="email" id="email" name="email" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all text-sm"
                placeholder="carlos@empresa.com">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block text-sm font-medium text-gray-300 mb-2">Nombre de la Empresa</label>
              <input type="text" id="company" name="company" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all text-sm"
                placeholder="Mi Empresa S.A.">
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-300 mb-2">Teléfono de contacto</label>
              <input type="tel" id="phone" name="phone" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all text-sm"
                placeholder="+52 55 1234 5678">
            </div>
          </div>

          <div>
            <label for="screens" class="block text-sm font-medium text-gray-300 mb-2">Cantidad de pantallas a desplegar</label>
            <div class="relative">
              <select id="screens" name="screens" required
                class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:border-transparent transition-all appearance-none text-sm">
                <option value="" disabled selected class="text-gray-500 bg-mesh-dark">Selecciona un rango...</option>
                <option value="1-5" class="bg-mesh-dark">1 - 5 pantallas (Piloto)</option>
                <option value="6-20" class="bg-mesh-dark">6 - 20 pantallas (Retail local)</option>
                <option value="21-100" class="bg-mesh-dark">21 - 100 pantallas (Expansión regional)</option>
                <option value="100+" class="bg-mesh-dark">Más de 100 pantallas (Enterprise)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <button type="submit" class="w-full bg-mesh-accent hover:bg-mesh-accentHover text-mesh-dark font-bold py-4 rounded-xl transition-all transform hover:scale-[1.01] shadow-[0_0_15px_rgba(0,240,255,0.2)] focus:outline-none focus:ring-2 focus:ring-mesh-accent focus:ring-offset-2 focus:ring-offset-mesh-card text-sm">
            Solicitar Contacto Comercial
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      if(btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = 'Enviando...';
        btn.setAttribute('disabled', 'true');
        
        // Simular envío
        setTimeout(() => {
          btn.innerHTML = '¡Solicitud Recibida!';
          btn.classList.add('bg-green-500');
          btn.classList.remove('bg-mesh-accent', 'hover:bg-mesh-accentHover');
          form.reset();
          
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('bg-green-500');
            btn.classList.add('bg-mesh-accent', 'hover:bg-mesh-accentHover');
            btn.removeAttribute('disabled');
          }, 3000);
        }, 1500);
      }
    });
  }
</script>
