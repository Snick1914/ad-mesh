---
const features = [
  {
    title: "Autonomía Total",
    description: "Modo Offline vía almacenamiento USB/HDD local. La pantalla sigue reproduciendo el contenido en caché aunque se pierda la conexión a internet por días.",
    icon: `<svg class="w-6 h-6 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>`
  },
  {
    title: "Monitoreo en Tiempo Real",
    description: "Métricas de salud, estado de conexión y uso de almacenamiento actualizados instantáneamente mediante WebSockets seguros.",
    icon: `<svg class="w-6 h-6 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`
  },
  {
    title: "Animaciones Fluidas",
    description: "Transiciones de alto rendimiento gráfico aceleradas por hardware. Cero parpadeos entre videos e imágenes, garantizando impacto visual premium.",
    icon: `<svg class="w-6 h-6 text-mesh-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  }
];
---

<section id="features" class="py-24 bg-mesh-dark relative border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ingeniería que garantiza visualización</h2>
      <p class="text-lg text-mesh-muted">Construido desde cero para resolver el mayor problema del Digital Signage: la dependencia de internet. Nuestro hardware y software trabajan en simbiosis perfecta.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="bg-mesh-card border border-white/10 rounded-2xl p-8 hover:bg-white/[0.03] transition-all duration-300 hover:border-mesh-accent/50 group">
          <div class="w-14 h-14 bg-mesh-dark rounded-xl border border-white/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:shadow-[0_0_15px_rgba(0,240,255,0.2)] transition-all duration-300" set:html={feature.icon} />
          <h3 class="text-xl font-bold text-white mb-3">{feature.title}</h3>
          <p class="text-mesh-muted leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
